# wrappers.def — the single source of truth for the symbols
# libalr_preload.so MUST define.  docs/04-preload-spec.md §6 designates this
# file as canonical, and §14 requires the PRELOAD CHK SYMBOLS PRESENT gate that
# reads it (scripts/check-preload.sh).
#
# WHY THIS FILE EXISTS
# Six mandatory exec entry points (posix_spawn, posix_spawnp, system, popen,
# pclose, fexecve/execveat) were absent for the entire life of the project and
# NOTHING flagged it: `make` was broken end to end, and every test passed
# because each one happened to reach the guest through a shell.  Eighteen more
# §6 symbols -- including fstat/fstat64, which §6.2 documents as mandatory for
# link-identity consistency -- were missing for the same reason.  A list that
# is merely dumped from the binary would be a tautology and could never catch
# this; the point is that this file records what the SPEC requires, and the
# gate reports the difference.
#
# ADDING A SYMBOL: add it here first, then implement it.  If the gate fails,
# the gate is right.
#
# Format: one symbol per line.  '#' starts a comment.

# --- 6.1  open family
# docs/04-preload-spec.md §6.1
open
open64
openat
openat64
creat
creat64
__open_2
__open64_2
__openat_2
__openat64_2
fopen
fopen64
freopen
freopen64

# --- 6.2  stat family (BOTH name sets)
# §6.2 — fstat/fstat64 are mandatory for §8.2 link identity
stat
stat64
lstat
lstat64
fstat
fstat64
fstatat
fstatat64
newfstatat
statx
statvfs
statvfs64
statfs
statfs64
__xstat
__xstat64
__lxstat
__lxstat64
__fxstat
__fxstat64
__fxstatat
__fxstatat64

# --- 6.3  access family
# §6.3
access
eaccess
euidaccess
faccessat
faccessat2

# --- 6.4  link / symlink
# §6.4 + §8 link2symlink
readlink
readlinkat
__readlink_chk
__readlinkat_chk
symlink
symlinkat
link
linkat

# --- 6.5  directories and cwd
# §6.5
opendir
scandir
scandir64
mkdir
mkdirat
rmdir
chdir
