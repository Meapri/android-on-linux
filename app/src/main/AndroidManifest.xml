<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="false"
        android:label="AndroLinux Runtime Lab"
        android:theme="@style/AppTheme">

        <!-- Compose 런처 진입점: MAIN/LAUNCHER (integration-guide §2). -->
        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 게스트 실행화면 (내부 진입 — LauncherActivity 가 띄움). SurfaceView +
             컴포지터가 surface 재생성에 민감하므로 회전/리사이즈를 자체 처리. -->
        <activity
            android:name=".ui.RunningSurfaceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:theme="@style/AppTheme" />

        <!-- 기존 probe 하니스 — LAUNCHER 강등(진단 전용, 외부 진입 불요).
             Standalone Chromium 경로(activity-alias .ui.ChromiumStandalone)가 이
             MainActivity 를 target 하므로, 회전/멀티윈도우/리사이즈가 Activity 를
             destroy/recreate 하지 않도록 configChanges 를 직접 처리한다 — SurfaceView +
             in-app Wayland 컴포지터가 살아남고, surfaceChanged 로 새 크기를 받아
             nativeWaylandCompositorResize 로 동적 재구성한다. resizeableActivity 로
             split-screen/free-form 멀티윈도우도 허용. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:resizeableActivity="true" />

        <!-- Standalone Chromium 앱 진입점: 탭하면 MainActivity 가 LEAN chromium-only
             경로(runChromiumStandalone)로 분기 — GPU/probe/GIMP/toolkit 전부 스킵해
             메모리를 chromium(browser+renderer)에 양보. 별도 런처 아이콘 "ALR Chromium". -->
        <activity-alias
            android:name=".ui.ChromiumStandalone"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="ALR Chromium">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
