<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- USB Host: enumerate + open physical USB devices over OTG/USB-C for the
         Linux guest's libusb shim (docs/design/android-usb-host.md §2.1). No
         runtime permission is needed — access is granted per-device by the
         system USB dialog. required=false keeps the APK installable without OTG. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <!-- Compose 런처 진입점: MAIN/LAUNCHER (integration-guide §2). -->
        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 게스트 실행화면 (내부 진입 — LauncherActivity 가 띄움). SurfaceView +
             컴포지터가 surface 재생성에 민감하므로 회전/리사이즈를 자체 처리. -->
        <!-- exported=true is required ONLY because the optional USB_DEVICE_ATTACHED
             intent-filter below makes the system able to route a USB-attach to it;
             internal launches still come from LauncherActivity. The auto-grant
             filter is optional polish (docs/design/android-usb-host.md §2.1) — the
             system USB-permission dialog path works without it. -->
        <activity
            android:name=".ui.RunningSurfaceActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- 기존 probe 하니스 — LAUNCHER 강등(진단 전용, 외부 진입 불요).
             Standalone Chromium 경로(activity-alias .ui.ChromiumStandalone)가 이
             MainActivity 를 target 하므로, 회전/멀티윈도우/리사이즈가 Activity 를
             destroy/recreate 하지 않도록 configChanges 를 직접 처리한다 — SurfaceView +
             in-app Wayland 컴포지터가 살아남고, surfaceChanged 로 새 크기를 받아
             nativeWaylandCompositorResize 로 동적 재구성한다. resizeableActivity 로
             split-screen/free-form 멀티윈도우도 허용. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:resizeableActivity="true" />

        <!-- Standalone Chromium 내부 진입점: MainActivity 의 LEAN chromium-only 경로
             (runChromiumStandalone — GPU/probe/GIMP/toolkit 스킵, 메모리를 browser+renderer
             에 양보)를 가리키는 alias. "Android on Linux" 단일 런처 아이덴티티를 위해 별도
             홈 아이콘(MAIN/LAUNCHER)을 제거했다 — alias 자체는 내부 타겟팅용으로 유지하되
             exported=false 로 외부 진입을 닫는다(런처 진입은 ui.LauncherActivity 단일 경로). -->
        <activity-alias
            android:name=".ui.ChromiumStandalone"
            android:targetActivity=".MainActivity"
            android:exported="false"
            android:label="ALR Chromium" />
    </application>
</manifest>
